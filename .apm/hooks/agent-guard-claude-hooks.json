{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${PLUGIN_ROOT}/.apm/hooks/scripts/claude-bash.sh",
            "timeout": 15,
            "failClosed": true
          }
        ]
      }
    ]
  }
}
